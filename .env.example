# Copy this file to .env and replace all change-me values.

# Host ports
API_PORT=8080
SQL_PORT=1433
REDIS_PORT=6379

# SQL Server (must satisfy SQL Server password complexity rules)
SQL_DATABASE=ECommerceDB
SQL_SA_PASSWORD=change-me-with-a-strong-password

# JWT (use at least 32 random characters)
JWT_KEY=change-me-with-a-long-random-secret-key
JWT_ISSUER=ECommerceApp
JWT_AUDIENCE=ECommerceAppUsers
JWT_EXPIRY_MINUTES=60

# SMTP
MAIL_ADDRESS=change-me@example.com
MAIL_DISPLAY_NAME=ECommerce Application
MAIL_PASSWORD=change-me
MAIL_HOST=smtp.example.com
MAIL_PORT=587

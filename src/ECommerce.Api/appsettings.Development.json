{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=.;Initial Catalog=E-CommerceDB;Integrated Security=True;TrustServerCertificate=True;",
    "Redis": "localhost:6379"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameWorkCore": "Information" 
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithProcessId"
    ],
    "Properties": {
      "Application": "ECommerceApplication"
    }
  },
  "AllowedOrigins": [
    "https://localhost:7201/Ecommerce.com",
    "http://localhost:4200"
  ]
}

{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=.;Initial Catalog=ECommerceDB;Integrated Security=True;TrustServerCertificate=True",
    "Redis": "localhost:6379"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      } //,
      //{
      //  "Name": "File",
      //  "Args": {
      //    "path": "/Logs/log-.txt",
      //    "rollingInterval": "Day",
      //    "rollOnFileSizeLimit": true,
      //    "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"//,
      //    //"outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
      //  }
      //}
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithProcessId"
    ],
    "Properties": {
      "Application": "ECommerceApplication"
    }
  },
  "AllowedHosts": "*",

  "MailSetting": {
    "Mail": "local@example.com",
    "DisplayName": "ECommerce AppLication",
    "Password": "configure-with-environment-variables",
    "Host": "smtp.example.com",
    "Port": 587
  },
  "Jwt": {
    "Key": "development-only-key-change-before-production-use",
    "Issuer": "ECommerceApp",
    "Audience": "ECommerceApp Users",
    "ExpiryMinutes": 100000
  },
  "AllowedOrigins": [
    "https://localhost:7201",
    "https://localhost:7202"
  ]
}
